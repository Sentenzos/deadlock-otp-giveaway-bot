# Создайте бота через @BotFather и добавьте его администратором в нужный Telegram-канал или группу.
TELEGRAM_BOT_TOKEN=replace_me
# Числовой Telegram ID владельца, которому разрешены команды /giveaway. Это не @username.
OWNER_TELEGRAM_ID=replace_me
# ID канала или группы для проверки подписки/членства и публикации розыгрышей. Обычно начинается с -100.
TELEGRAM_REQUIRED_CHAT_ID=replace_me
# Telegram-ники без @, которых нельзя учитывать в розыгрышах. Несколько ников — через запятую.
TELEGRAM_EXCLUDED_USERNAMES=

TWITCH_CHANNEL=deadlock_otp
# Логин Twitch-аккаунта, которым бот подключается к чату.
TWITCH_BOT_LOGIN=deadlock_otp
# User OAuth-token этого Twitch-аккаунта со scope chat:read, chat:edit и moderator:read:chatters.
# chat:edit нужен для анонсов розыгрыша в Twitch-чате, moderator:read:chatters — для /viewers.
# Значение без префикса oauth:.
TWITCH_OAUTH_TOKEN=replace_me
# Twitch-логины, которых нельзя учитывать в розыгрышах. Несколько логинов — через запятую.
TWITCH_EXCLUDED_LOGINS=
# Как часто проверять, идёт ли стрим, в секундах.
TWITCH_LIVE_CHECK_INTERVAL_SECONDS=10

# Файл SQLite. Для VPS лучше задать абсолютный путь.
DATABASE_PATH=data/giveaway_bot.sqlite3
